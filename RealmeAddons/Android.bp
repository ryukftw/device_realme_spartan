android_app {
    name: "RealmeAddons",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.preference_preference",
        "SettingsLib",
        "SettingsLibCollapsingToolbarBaseActivity",
        "org.lineageos.settings.resources",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    required: [
        "privapp_whitelist_org.lineageos.settings.device",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.lineageos.settings.device",
    sub_dir: "permissions",
    src: "privapp-permissions-org.lineageos.settings.device.xml",
    filename_from_src: true,
    system_ext_specific: true,
}
