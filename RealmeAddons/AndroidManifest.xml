<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.device"
    android:versionCode="1"
    android:versionName="1.0"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:icon="@drawable/ic_settings_device"
        android:label="@string/device_settings_app_name"
        android:persistent="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".DeviceSettingsActivity"
            android:exported="true"
            android:label="@string/device_settings_title"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_settings_device" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/device_settings_summary" />
        </activity>

        <activity
            android:name=".gameoptimizer.GameOptimizerActivity"
            android:exported="true"
            android:label="@string/game_optimizer_title"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_game_optimizer" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/game_optimizer_summary" />
        </activity>

        <service
            android:name=".display.AntiFlikerTileService"
            android:icon="@drawable/ic_anti_flicker"
            android:label="@string/anti_flicker_tile_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".battery.BypassChargingTileService"
            android:icon="@drawable/ic_bypass_charging"
            android:label="@string/bypass_charging_tile_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".battery.PowerStateMonitorService"
            android:exported="false" />

        <!-- Thermal Profiles -->
        <activity
            android:name=".thermal.ThermalProfileActivity"
            android:exported="false"
            android:label="@string/thermal_profile_title"
            android:enableOnBackInvokedCallback="true" />

        <service
            android:name=".thermal.ThermalTileService"
            android:icon="@drawable/ic_thermal_profile"
            android:label="@string/thermal_profile_tile_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".thermal.ThermalMonitorService"
            android:exported="false" />

        <!-- GameBar Overlay -->
        <activity
            android:name=".gamebar.GameBarSettingsActivity"
            android:exported="false"
            android:label="@string/game_bar_title"
            android:enableOnBackInvokedCallback="true" />

        <activity
            android:name=".gamebar.GameBarAppSelectorActivity"
            android:exported="false"
            android:label="Select Apps" />

        <activity
            android:name=".gamebar.GameBarAppRemoverActivity"
            android:exported="false"
            android:label="Remove Apps" />

        <service
            android:name=".gamebar.GameBarTileService"
            android:icon="@drawable/ic_game_bar"
            android:label="@string/game_bar_tile_label"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".gamebar.GameBarMonitorService"
            android:exported="false" />

        <receiver
            android:name=".gamebar.GameBarBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
